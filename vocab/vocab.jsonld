  "@graph": [
    {
      "@id": "https://play.ldas.jp/vocab/#equipment",
      "@type": "skos:ConceptScheme",
      "prefLabel": { "en": "Playground equipment types", "ja": "遊具の型" },
      "definition": {
        "en": "Types of playground equipment, defined by shape and movement. Product names are not used as type names.",
        "ja": "遊具の型。形と動きで定義し、製品名を型の名前にしない。"
      },
      "hasTopConcept": ["https://play.ldas.jp/vocab/#swing", "https://play.ldas.jp/vocab/#slide", "https://play.ldas.jp/vocab/#climbing", "https://play.ldas.jp/vocab/#overhead", "https://play.ldas.jp/vocab/#spinning", "https://play.ldas.jp/vocab/#seesaw", "https://play.ldas.jp/vocab/#spring", "https://play.ldas.jp/vocab/#water", "https://play.ldas.jp/vocab/#sound", "https://play.ldas.jp/vocab/#panel", "https://play.ldas.jp/vocab/#sand", "https://play.ldas.jp/vocab/#zipline", "https://play.ldas.jp/vocab/#structure", "https://play.ldas.jp/vocab/#fitness"]
    },
    {
      "@id": "https://play.ldas.jp/vocab/#products",
      "@type": "skos:ConceptScheme",
      "prefLabel": { "en": "Playground equipment products", "ja": "遊具の製品" },
      "definition": {
        "en": "Manufacturers' products, each matched to an equipment type.",
        "ja": "メーカーの製品。それぞれ遊具の型に対応づける。"
      }
    },
    {
      "@id": "https://play.ldas.jp/vocab/#amenities",
      "@type": "skos:ConceptScheme",
      "prefLabel": { "en": "Park amenities", "ja": "公園の設備" },
      "definition": {
        "en": "Things in a park other than play equipment, such as a drinking fountain, recorded on site.",
        "ja": "遊具ではない、公園の中のもの（水飲み場など）。現地調査で記録したもの。"
      },
      "hasTopConcept": ["https://play.ldas.jp/vocab/#drinking-fountain", "https://play.ldas.jp/vocab/#shade-sail", "https://play.ldas.jp/vocab/#open-lawn", "https://play.ldas.jp/vocab/#carved-boulder", "https://play.ldas.jp/vocab/#toy-box"]
    },
    {
      "@id": "pgv:differentFrom",
      "@type": "rdf:Property",
      "subPropertyOf": "skos:related",
      "label": { "en": "different from", "ja": "別物" },
      "comment": {
        "en": "A type that looks similar but is a different type. Stated in both directions.",
        "ja": "見た目が似ているが別の型。両方向に張る。"
      }
    },
