    {
      "@id": "https://play.ldas.jp/vocab/#overhead-spinning-rings",
      "@type": "skos:Concept",
      "inScheme": "https://play.ldas.jp/vocab/#equipment",
      "broader": ["https://play.ldas.jp/vocab/#overhead", "https://play.ldas.jp/vocab/#spinning"],
      "differentFrom": ["https://play.ldas.jp/vocab/#single-overhead-spinning-ring", "https://play.ldas.jp/vocab/#post-spinning-ring", "https://play.ldas.jp/vocab/#circular-horizontal-ladder", "https://play.ldas.jp/vocab/#hanging-rings"],
      "exactMatch": "https://chicagoplaygrounds.com/s/guide/item/3164",
      "altLabel": { "en": ["spinning monkey bars", "monkey bar wheel"] },
      "definition": { "ja": "横に渡した 1 本の梁の下に輪が 3 つ吊られ、それぞれの輪が自由に回る。輪どうしは同じ面に並ばない" },
      "editorialNote": { "ja": "Myrtle Park の写真と照合済み（2026-10-11）" },
      "prefLabel": { "en": "Overhead Spinning Rings", "ja": "回る輪の雲梯（梁から吊る型）" }
    },
    {
      "@id": "https://play.ldas.jp/vocab/#single-overhead-spinning-ring",
