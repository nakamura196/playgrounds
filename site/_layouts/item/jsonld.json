{%- comment -%}
    JSON-LD of one park, generated by cb_page_gen
    (see `page_gen` in _config.yml: template jsonld, permalink /items/:name.jsonld).

    The park is a schema:Park. Identifiers use `lod-base` in _config.yml, not the
    build's own baseurl, so the Japanese and English builds give the same URIs:
      park       <lod-base>/items/<objectid>   (GitHub Pages serves the .html page)
      equipment  <lod-base>/vocab/#<type id>   (SKOS concepts in /vocab/vocab.jsonld)

    Other park facilities (the `subject` column) and washrooms are amenityFeature
    entries with a name and a true/false value. Play equipment (the `equipment`
    column, type ids from vocab/types.csv separated by ;) is also an amenityFeature,
    with additionalType pointing to the concept, as chicagoplaygrounds.com links
    playgrounds to its equipment items with schema:amenityFeature.
{%- endcomment -%}
{%- assign base = site.url | append: site.baseurl -%}{%- if site.lod-base -%}{%- assign base = site.lod-base -%}{%- endif -%}
{%- assign item_id = base | append: '/items/' | append: page.objectid -%}
{%- assign facilities = page.subject | split: ';' -%}
{%- assign equipment = page.equipment | split: ';' -%}
{
  "@context": {
    "@vocab": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": {{ item_id | jsonify }},
  "@type": "Park",
  "name": {{ page.title | jsonify }},
  {%- if page.description %}
  "description": {{ page.description | jsonify }},{% endif %}
  "identifier": {{ page.parkid | jsonify }},
  {%- if page.location %}
  "address": {{ page.location | jsonify }},{% endif %}
  {%- if page.latitude and page.longitude %}
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ page.latitude | plus: 0 }},
    "longitude": {{ page.longitude | plus: 0 }}
  },{% endif %}
  {%- if page.neighbourhood %}
  "containedInPlace": {
    "@type": "Place",
    "name": {{ page.neighbourhood | jsonify }}
  },{% endif %}
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "playground count",
      "value": {{ page.playground_count | plus: 0 }}
    }{% if page.hectare %},
    {
      "@type": "PropertyValue",
      "name": "area",
      "value": {{ page.hectare | plus: 0 }},
      "unitCode": "HAR",
      "unitText": "ha"
    }{% endif %}{% if page.surveyed %},
    {
      "@type": "PropertyValue",
      "name": "equipment surveyed on",
      "value": {{ page.surveyed | jsonify }}
    }{% endif %}
  ],
  "amenityFeature": [
    {%- for e in equipment %}{% assign e = e | strip %}{% assign concept = site.data.vocab.types | where: 'id', e | first %}
    {
      "@type": "LocationFeatureSpecification",
      "name": {{ concept.label_en | default: e | jsonify }},
      "value": true,
      "additionalType": { "@id": {{ base | append: '/vocab/#' | append: e | jsonify }} }
    },{% endfor %}
    {%- for f in facilities %}
    {
      "@type": "LocationFeatureSpecification",
      "name": {{ f | strip | jsonify }},
      "value": true
    },{% endfor %}
    {
      "@type": "LocationFeatureSpecification",
      "name": "Washrooms",
      "value": {% if page.washrooms == 'Y' %}true{% else %}false{% endif %}
    }
  ],
  "mainEntityOfPage": {{ page.objectid | prepend: '/items/' | append: '.html' | prepend: base | jsonify }},
  "isPartOf": { "@id": {{ base | append: '/' | jsonify }}, "name": {{ site.title | jsonify }} },
  "isBasedOn": [
    "https://opendata.vancouver.ca/explore/dataset/parks/",
    "https://opendata.vancouver.ca/explore/dataset/parks-facilities/"
  ],
  "license": "https://opendata.vancouver.ca/pages/licence/",
  "creditText": {{ page.rights | jsonify }}
}
