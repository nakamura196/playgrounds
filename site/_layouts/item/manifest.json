{%- comment -%}
    IIIF Presentation 3.0 manifest of one park's survey photos, generated by cb_page_gen
    (see `page_gen` in _config.yml: template manifest, permalink /iiif/:name.json,
    only for parks that have photos, i.e. display_template compound_object).

    The photos stay on Wikimedia Commons. Each canvas paints the original JPEG from
    upload.wikimedia.org (no IIIF Image API service: Commons does not offer one), so
    viewers show the whole image without deep zoom. Width and height come from the
    `image_width` / `image_height` columns (Commons imageinfo, see collection/photos.csv).

    Ids use `lod-base` in _config.yml, so the Japanese and English builds give the same
    manifest id. The park's position is given with the navPlace extension.
{%- endcomment -%}
{%- assign base = site.url | append: site.baseurl -%}{%- if site.lod-base -%}{%- assign base = site.lod-base -%}{%- endif -%}
{%- assign manifest_id = base | append: '/iiif/' | append: page.objectid | append: '.json' -%}
{%- assign children = site.data[site.metadata] | where_exp: 'item','item.parentid == page.objectid' -%}
{
  "@context": [
    "http://iiif.io/api/extension/navplace/context.json",
    "http://iiif.io/api/presentation/3/context.json"
  ],
  "id": {{ manifest_id | jsonify }},
  "type": "Manifest",
  "label": { "none": [ {{ page.title | jsonify }} ] },
  {%- if page.description %}
  "summary": { "en": [ {{ page.description | jsonify }} ] },{% endif %}
  "metadata": [
    {%- if page.location %}
    { "label": { "en": [ "Location" ], "ja": [ "所在地" ] }, "value": { "none": [ {{ page.location | jsonify }} ] } },{% endif %}
    {%- if page.surveyed %}
    { "label": { "en": [ "Surveyed" ], "ja": [ "現地で確認した日" ] }, "value": { "none": [ {{ page.surveyed | jsonify }} ] } },{% endif %}
    {%- assign eq_en = "" | split: "" -%}{%- assign eq_ja = "" | split: "" -%}
    {%- assign eq_ids = page.equipment | split: ";" -%}
    {%- for e in eq_ids -%}{%- assign term = site.data.vocab.types | where: "id", e | first -%}
    {%- assign eq_en = eq_en | push: term.label_en -%}{%- assign eq_ja = eq_ja | push: term.label_ja -%}{%- endfor %}
    { "label": { "en": [ "Play equipment" ], "ja": [ "遊具" ] }, "value": { "en": [ {{ eq_en | join: "; " | jsonify }} ], "ja": [ {{ eq_ja | join: "、" | jsonify }} ] } }
  ],
  "requiredStatement": {
    "label": { "en": [ "Attribution" ], "ja": [ "クレジット" ] },
    "value": { "en": [ "Photos: Satoru Nakamura, CC BY 4.0, via Wikimedia Commons" ] }
  },
  "rights": "http://creativecommons.org/licenses/by/4.0/",
  "homepage": [
    { "id": {{ base | append: '/items/' | append: page.objectid | append: '.html' | jsonify }}, "type": "Text", "label": { "none": [ {{ page.title | jsonify }} ] }, "format": "text/html" }
  ],
  "seeAlso": [
    { "id": {{ base | append: '/items/' | append: page.objectid | append: '.jsonld' | jsonify }}, "type": "Dataset", "format": "application/ld+json", "profile": "https://schema.org/" }
  ],
  {%- if page.latitude and page.longitude %}
  "navPlace": {
    "id": {{ manifest_id | append: '/feature-collection/1' | jsonify }},
    "type": "FeatureCollection",
    "features": [
      {
        "id": {{ manifest_id | append: '/feature/1' | jsonify }},
        "type": "Feature",
        "properties": { "label": { "none": [ {{ page.title | jsonify }} ] } },
        "geometry": { "type": "Point", "coordinates": [ {{ page.longitude | plus: 0 }}, {{ page.latitude | plus: 0 }} ] }
      }
    ]
  },{% endif %}
  "items": [
    {%- for c in children %}
    {%- assign canvas_id = manifest_id | append: '/canvas/' | append: forloop.index -%}
    {
      "id": {{ canvas_id | jsonify }},
      "type": "Canvas",
      "label": { "en": [ {{ c.title | jsonify }} ] },
      {%- if c.description %}
      "summary": { "en": [ {{ c.description | jsonify }} ] },{% endif %}
      "width": {{ c.image_width | plus: 0 }},
      "height": {{ c.image_height | plus: 0 }},
      "thumbnail": [ { "id": {{ c.image_thumb | jsonify }}, "type": "Image", "format": "image/jpeg" } ],
      {%- if c.commons %}
      "homepage": [ { "id": {{ c.commons | jsonify }}, "type": "Text", "label": { "en": [ "File page on Wikimedia Commons" ] }, "format": "text/html" } ],{% endif %}
      "items": [
        {
          "id": {{ canvas_id | append: '/page/1' | jsonify }},
          "type": "AnnotationPage",
          "items": [
            {
              "id": {{ canvas_id | append: '/annotation/1' | jsonify }},
              "type": "Annotation",
              "motivation": "painting",
              "body": {
                "id": {{ c.object_location | jsonify }},
                "type": "Image",
                "format": "image/jpeg",
                "width": {{ c.image_width | plus: 0 }},
                "height": {{ c.image_height | plus: 0 }}
              },
              "target": {{ canvas_id | jsonify }}
            }
          ]
        }
      ]
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
