# Ignore metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore mac files 
.DS_Store

# temporarily ignore gemfile.lock
Gemfile.lock

# Ignore objects directory to avoid committing binary files (other than demo files)
# if you would like to commit your objects to github, delete the line below!
objects/*
# ...except the locally hosted sample items of this demo (_tools/local_sample.py)
# and their derivatives / static IIIF files (rake generate_iiif)
!objects/local_*.jpg
!objects/small/
objects/small/*
!objects/small/local_*
!objects/thumbs/
objects/thumbs/*
!objects/thumbs/local_*
!objects/iiif/
objects/iiif/*
!objects/iiif/3/
objects/iiif/3/*
!objects/iiif/3/local_*
!objects/iiif/2/
objects/iiif/2/*
!objects/iiif/2/local_*
_tools/cache/
.dev-iiif.yml
